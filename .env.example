# ============================================
# K-UniTrust Dashboard
# cp .env.example .env 후 값을 채우세요.
# ============================================

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- V-World (브이월드 오픈API) -----
# https://www.vworld.kr — API 인증키 신청 후 발급
# 서비스 URL에 http://localhost:3000 (및 운영 도메인) 등록 필요
#
# 지오코딩·행정경계 등 서버 전용 (클라이언트 노출 금지)
VWORLD_API_KEY=
#
# 지도 JavaScript SDK용 (브라우저 노출 — 도메인 제한으로 보호)
NEXT_PUBLIC_VWORLD_MAP_KEY=

# ----- Access (아이디 없음, 비밀번호만) -----
# 관리자: 전 메뉴 권한 / 사용자: 업로드·분석 일부(메뉴별 권한은 추후)
KUNITRUST_ADMIN_PASSWORD=
KUNITRUST_USER_PASSWORD=
KUNITRUST_AUTH_SECRET=
